syntax = "v1"

type (
    SingleMSG {
        SenderId int64 `json:"sender_id"`              // 发送者ID
        SenderName string `json:"sender_name"`         // 发送者名称
        SenderAvatar string `json:"sender_avatar"`     // 发送者头像
        Type int8 `json:"type"`                        // 消息类型
        Content string `json:"content"`                // 消息内容
        TargetContent string `json:"target_content"`   // 目标内容
        Time uint64 `json:"time"`                      // 消息时间
    }
    MultiMSG {
        SenderNames []string `json:"sender_name"`     // 发送者名称
        SenderAvatars []string `json:"sender_avatar"` // 发送者头像
        Type int8 `json:"type"`                       // 消息类型
        Total uint64 `json:"total"`                   // 消息总数
        Time uint64 `json:"time"`                     // 消息时间
    }
)

type (
    GetNotificationResponse {
        SingleMSG []SingleMSG `json:"single_msg"`    // 消息列表
        Total uint64 `json:"total"`                  // 消息总数
    }
    GetNotificationMultiResponse {
        MultiMSG []MultiMSG `json:"multi_msg"`    // 消息列表
        Total uint64 `json:"total"`               // 消息总数
    }
    GetNotificationRequest {
        Type uint8 `query:"type,optional"`             // 消息类型
        Page uint64 `query:"page,optional,default=1"`  // 页码
        Size uint64 `query:"size,optional,default=15"` // 每页数量
    }
    MarkReadResponse {
        Success bool `json:"success"` // 操作是否成功
    }
    UnreadCountResponse {
        CommentCount uint64 `json:"comment_count"` // 评论未读数量
        LikeCount uint64 `json:"like_count"`       // 点赞未读数量
        FavoriteCount uint64 `json:"favorite_count"` // 收藏未读数量
        FollowCount uint64 `json:"follow_count"`   // 关注未读数量
        TotalCount uint64 `json:"total_count"`     // 总未读数量
    }
)
@server(
    prefix: /v1/notification
    group: notification
    signature: true
    jwt: Auth
)
service keyframeGo {
    // 获取评论通知
    @handler GetCommentNotification
    get /notification/comment (GetNotificationRequest) returns (GetNotificationResponse)
    
    // 获取点赞通知
    @handler GetLikeNotification
    get /notification/like (GetNotificationRequest) returns (GetNotificationMultiResponse)
    
    // 获取收藏通知
    @handler GetFavoriteNotification
    get /notification/favorite (GetNotificationRequest) returns (GetNotificationMultiResponse)
    
    // 获取关注通知
    @handler GetFollowNotification
    get /notification/follow (GetNotificationRequest) returns (GetNotificationResponse)
    
    // 标记所有通知为已读
    @handler MarkAllNotificationRead
    put /notification/read/all returns (MarkReadResponse)
    
    // 获取未读通知数量
    @handler GetUnreadNotificationCount
    get /notification/unread/count returns (UnreadCountResponse)
}
