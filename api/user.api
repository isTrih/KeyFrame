syntax = "v1"

info(
    title: "General Chaozj API"
    desc: "the api for general chaozj service"
    author: "Trih"
    email: "hhh@chaozj.com"
    version: "v1"
)

type (
    RegisterRequest {
        Username string `json:"username"`
        Password string `json:"password"`
        Mobile string `json:"mobile"`
        VerifyCode string `json:"verifyCode"`
    }
    RegisterResponse {
        UserId uint64 `json:"userId"`
        Token string `json:"token"`
    }
    VerifyCodeRequest {
        Mobile string `json:"mobile"`
    }
    VerifyCodeResponse {
        Status string `json:"status"`
    }
    LoginRequest {
        UserId uint64 `json:"userId"`
        Password string `json:"password"`
    }
    LoginMobilePassRequest {
        Mobile string `json:"mobile"`
        Password string `json:"password"`
    }
    LoginResponse {
        UserId uint64 `json:"userId"`
        Token string `json:"token"`
    }
    UserInfoResponse {
        UserId uint64 `json:"userId"`
        Username string `json:"username"`
        Avatar string `json:"avatar"`
        Type uint8 `json:"type"`
    }
    ChangeMobileRequest {
        OldMobile string `json:"oldMobile"`
        NewMobile string `json:"newMobile"`
        VerifyCode string `json:"verifyCode"`
    }
    ChangeMobileResponse {
        Status string `json:"status"`
    }
)

type (
    Auth {
        Token string `json:"token"`
    }

    ChangePasswordRequest {
        OldPassword string `json:"oldPassword"`
        NewPassword string `json:"newPassword"`
    }
    ChangePasswordResponse {
        Status string `json:"status"`
    }

    ChangeUserInfoRequest {
        Nickname string `db:"nickname"`   // 昵称
        Signature string `db:"signature"` // 简介
        Avatar string `db:"avatar"`       // 头像
    }

    ChangeUserInfoResponse {
        Status string `json:"status"`
    }
)

@server(
    prefix: /v1/user
    group: user
)
service chaozjani {
    @doc "用户注册"
    @handler RegisterHandler
    post /register (RegisterRequest) returns (RegisterResponse)

    @doc "获取验证码"
    @handler VerifyCodeHandler
    post /verify-code (VerifyCodeRequest) returns (VerifyCodeResponse)

    @doc "uid账号登录"
    @handler LoginHandler
    post /login (LoginRequest) returns (LoginResponse)

    @doc "手机密码登录"
    @handler LoginByMobilePassHandler
    post /login-mobile-pass (LoginMobilePassRequest) returns (LoginResponse)

    @doc "更改手机号码"
    @handler ChangeMobileHandler
    post /change-mobile (ChangeMobileRequest) returns (ChangeMobileResponse)
}

@server(
    prefix: /v1/user
    signature: true
    jwt: Auth
    //    middleware: TokenUpdateMiddleware
    group: user
)

service chaozjani {
    @doc "获取用户信息 需要token"
    @handler UserInfoHandler
    get /info returns (UserInfoResponse)

    @doc "更改密码 需要token"
    @handler ChangePasswordHandler
    post /change-password (ChangePasswordRequest) returns (ChangePasswordResponse)

    @doc "更改用户信息 需要token"
    @handler ChangeUserInfoHandler
    post /change-info (ChangeUserInfoRequest) returns (ChangeUserInfoResponse)
}