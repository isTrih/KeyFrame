syntax = "v1"

type (
    NewArticleRequest {
        Title string `json:"title"`                   // 标题
        Content string `json:"content"`               // 内容
        Media []string `json:"media"`              // 封面
        Description string `json:"description"`       // 描述
    }

    StatusResponse {
        status string `json:"status"`
    }

    DeleteArticleRequest {
        Id uint64 `json:"id"`
    }

    SearchArticleRequest {
        Title string `json:"title"`
        Author string `json:"author"`
        Tag string `json:"tag"`
    }

    SearchArticleResponse {
        Articles []Article `json:"articles"`
    }

    GetArticleRequest {
        Id uint64 `json:"id"`
    }

    GetArticleResponse {
        Article Article `json:"article"`
    }
)

@server(
    prefix: /v1/article
    group: article
    signature: true
    jwt: Auth
)


service chaozjani {
    @doc "帧（文章）详情"
    @handler GetArticle
    post /detail (GetArticleRequest) returns (GetArticleResponse)

    @doc "创建帧（文章）"
    @handler NewArticle
    post /new (NewArticleRequest) returns (StatusResponse)

    @doc "删除帧（文章）"
    @handler DeleteArticle
    post /delete (DeleteArticleRequest) returns (StatusResponse)

    @doc "搜索帧（文章）"
    @handler SearchArticle
    post /search (SearchArticleRequest) returns (SearchArticleResponse)
}