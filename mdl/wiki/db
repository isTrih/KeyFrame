-- 删除可能存在的同名函数和触发器
   DROP FUNCTION IF EXISTS insert_custom_word() CASCADE;
   DROP TRIGGER IF EXISTS wiki_name_trigger ON public.wiki;

   -- 创建一个函数，用于处理触发器事件并执行插入操作
   CREATE OR REPLACE FUNCTION insert_custom_word() RETURNS trigger AS $$
   DECLARE
       -- 声明一个变量来存储 JSON 数据中的中文值
       chinese_value TEXT;
   BEGIN
       -- 检查是插入操作还是更新操作
       IF TG_OP = 'INSERT' THEN
           -- 提取 JSON 数据中的中文值
           chinese_value := NEW.name ->> 'zh';
           -- 插入操作时，将中文值插入到表中
           IF chinese_value IS NOT NULL THEN
               INSERT INTO zhparser.zhprs_custom_word (word)
               VALUES (chinese_value);
           END IF;
       ELSIF TG_OP = 'UPDATE' THEN
           -- 提取 JSON 数据中的中文值（新记录和旧记录都提取）
           chinese_value := NEW.name ->> 'zh';
           DECLARE
               old_chinese_value TEXT;
           BEGIN
               old_chinese_value := OLD.name ->> 'zh';
               -- 更新操作时，如果中文值发生了变化
               IF chinese_value IS DISTINCT FROM old_chinese_value THEN
                   IF chinese_value IS NOT NULL THEN
                       INSERT INTO zhparser.zhprs_custom_word (word)
                       VALUES (chinese_value);
                   END IF;
               END IF;
           END;
       END IF;
       RETURN NEW;
   END;
   $$ LANGUAGE plpgsql;

   -- 创建触发器，在wiki表的插入和更新操作时触发
   CREATE TRIGGER wiki_name_trigger
   AFTER INSERT OR UPDATE ON public.wiki
   FOR EACH ROW
   EXECUTE FUNCTION insert_custom_word();
