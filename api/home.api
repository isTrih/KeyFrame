syntax = "v1"
type (
    MediaInfo {
        Width uint32 `json:"width"`
        Height uint32 `json:"height"`
    }


        // 文章作者
    FeedUser {
        Id uint64 `json:"user_id"`
        UserName string `json:"user_name"`
        Avatar string `json:"avatar"`
        Type uint16 `json:"type"`
    }

        // 文章
    Feed {
        Title string `json:"title"`
        Id uint64 `json:"id"`
        MediaUrl string `json:"media_url"`
        MediaInfo MediaInfo `json:"media"`
        LikeNum uint32 `json:"like_num"`
        Loaded bool `json:"loaded"`
        User FeedUser `json:"user"`
    }
)

type (

)

type (
    GetIndexFeedsRequest {
        Offset uint64 `form:"os, default=0"`
        Query string `form:"q, optional"`
    }

    GetIndexFeedsResponse {
        Status string `json:"status"`
        Feeds []Feed `json:"feeds"`
    }

    UserFeedsRequest {
        Offset uint64 `form:"os, default=0"`
        UserId uint64 `form:"uid"`
        FeedType uint8 `form:"ftype, default=0"`
    }

//    SearchFeedRequest {
//        Offset uint64 `json:"offset, default=0"`
//        Query string `json:"query, optional"`
//        Title string `json:"title, optional"`
//        Author string `json:"author, optional"`
//        Tag string `json:"tag, optional"`
//    }
)


@server(
    prefix: /v1/home
    group: home
)

service keyframeGo {
    @doc "获取首页信息流"
    @handler GetIndexFeeds
    get /getfeeds (GetIndexFeedsRequest) returns (GetIndexFeedsResponse)

    @doc "获取用户主页帖子"
    @handler UserFeeds
    get /userfeeds (UserFeedsRequest) returns (GetIndexFeedsResponse)

//    @doc "搜索帧（文章）"
//    @handler SearchFeed
//    get /search (GetIndexFeedsRequest) returns (GetIndexFeedsResponse)
}

