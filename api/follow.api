syntax = "v1"

type (
    FollowRequest {
        UserId uint64`json:"user_id"`
    }
    FollowResponse {
        Status string `json:"status"`
    }

    FollowListResponse {
        Status string `json:"status"`
        FollowList []User `json:"follow_list"`
    }
)

@server(
    prefix:    /v1/follow
    signature: true
    jwt: Auth
    group: follow
)


service keyframeGo {
    @doc "关注/取消关注用户"
    @handler FollowHandler
    post /follow (FollowRequest) returns (FollowResponse)


    @doc "获取用户的关注列表"
    @handler GetFollowListHandler
    get /followList (FollowRequest) returns (FollowListResponse)

    @doc "获取用户的粉丝列表"
    @handler GetFansListHandler
    get /fansList (FollowRequest) returns (FollowListResponse)
}