syntax = "v1"

type (
//    ChangeResquest  {
//        key string `json:"key"`
//    }
    GetUpTokenResponse {
        token string `json:"token"`
    }

    GetUpTokenRequest {
        Type string `form:"t, default=img"`
    }
)

@server(
    prefix: /v1/upload
    signature: true
    jwt: Auth
    group: upload
)
service keyframeGo {
    @doc "获取到上传token"
    @handler GetUpToken
    get /normal (GetUpTokenRequest) returns (GetUpTokenResponse)

//    @doc "获取到上传修改型token"
//    @handler GetUpTokenChange
//    get /change (ChangeResquest) returns (GetUpTokenResponse)
}