syntax = "v1"
type (
    MediaInfo {
        Width uint32 `json:"width"`
        Height uint32 `json:"height"`
    }


        // 文章作者
    FeedUser {
        Id uint64 `json:"user_id"`
        UserName string `json:"user_name"`
        Avatar string `json:"avatar"`
    }

        // 文章
    Feed {
        Title string `json:"title"`
        Id uint64 `json:"id"`
        MediaUrl string `json:"media_url"`
        MediaInfo MediaInfo `json:"media"`
        ViewNum uint32 `json:"view_num"`
        LikeNum uint32 `json:"like_num"`
        Loaded bool `json:"loaded"`
        User FeedUser `json:"user"`
    }
)

type (

)

type (
    GetIndexFeedsRequest {
        Offset uint64 `json:"offset"`
        Query string `json:"query, optional"`
    }

    GetIndexFeedsResponse {
        Status string `json:"status"`
        Feeds []Feed `json:"feeds"`
    }

    UserFeedsRequest {
        Offset uint64 `json:"offset"`
        UserId uint64 `json:"user_id"`
        FeedType string `json:"feed_type"`
    }

    SearchFeedRequest {
        Offset uint64 `json:"offset, default=0"`
        Query string `json:"query, optional"`
        Title string `json:"title, optional"`
        Author string `json:"author, optional"`
        Tag string `json:"tag, optional"`
    }
)


@server(
    prefix: /v1/home
    group: home
)

service chaozjani {
    @doc "获取首页信息流"
    @handler GetIndexFeeds
    post /getfeeds (GetIndexFeedsRequest) returns (GetIndexFeedsResponse)

    @doc "获取用户主页帖子"
    @handler UserFeeds
    post /userfeeds (UserFeedsRequest) returns (GetIndexFeedsResponse)

    @doc "搜索帧（文章）"
    @handler SearchFeed
    post /search (GetIndexFeedsRequest) returns (GetIndexFeedsResponse)
}

