syntax = "v1"
type (
    // 文章
    FeedDetail {
        Title string `json:"title"`                                                       // 标题
        Id uint64 `json:"id"`                                                             // ID
        MediaUrl string `json:"media_url"`                                                // 封面
        Content string `json:"content"`                                                   // 内容
        CommentNum uint64 `json:"comment_num"`                                            // 评论数
        LikeNum uint64 `json:"like_num"`                                                  // 点赞数
        CollectNum uint64 `json:"collect_num"`                                            // 收藏数
        MediaInfo MediaInfo `json:"media"`                                                // 多媒体信息
        MediaList []string `json:"media_list"`                                            // 多媒体列表
        Author FeedUser `json:"user"`                                                     // 作者
        PublishTime uint64 `json:"publish_time"`                                          // 发布时间
        IpLocation string `json:"ip_location"`                                            // ip归属地
    }
    Feeds {
        Title string `json:"title"`
        Id uint64 `json:"id"`
        AuthorId uint64 `json:"author_id"`
        UserName string `json:"nickname"`
        Avatar string `json:"avatar"`
        CoverUrl string `json:"cover_url"`
        Height uint32 `json:"height"`
        Width uint32 `json:"width"`
        LikeNum uint32 `json:"like_num"`
        CollectNum uint32 `json:"collect_num"`
        CommentNum uint32 `json:"comment_num"`
        PublishTime uint64 `json:"publish_time"`
        Insp uint8 `json:"insp"`       // 审核
        AiInsp uint8 `json:"ai_insp"` // AI审核
    }
)
type (
    NewFeedRequest {
        Title string `json:"title"`                                   // 标题
        Content string `json:"content"`                               // 富文本内容
        RawContent string `json:"raw_content"`                        // 原始内容
        Cover string `json:"cover,optional"`                          // 封面
        CoverInfo MediaInfo `json:"cover_info,optional"`              // 封面信息
        Media []string `json:"media,optional"`                        // 图片
        KIP string `header:"kip,optional"`
        Id uint64 `json:"id"`                                         // 文章ID
    }

    DeleteFeedRequest {
        Id uint64 `json:"id"`
    }

    GetFeedDetailRequest {
        Id uint64 `path:"id"`
    }

    GetFeedListRequest {
        Offset uint64 `form:"o"`
    }
    GetFeedListResponse {
        Status string `json:"status"`
        Feeds []Feeds `json:"feeds"`
        Total uint64 `json:"total"`
    }


    GetFeedDetailResponse {
        Feed FeedDetail `json:"Feed"`
    }

    ShareFeedXHSResponse {
        Nonce string `json:"nonce"`
        Signature string `json:"signature"`
        Timestamp string `json:"timestamp"`
    }
)

@server(
    prefix: /v1/feed
    group: feed
    signature: true
)


service keyframeGo {
    @doc "帧（文章）详情"
    @handler GetFeedDetail
    get /:id (GetFeedDetailRequest) returns (GetFeedDetailResponse)
}


@server(
    prefix: /v1/feed
    group: feed
    signature: true
    jwt: Auth
)


service keyframeGo {
    @doc "创建帧（文章）"
    @handler NewFeed
    post /new (NewFeedRequest) returns (StatusResponse)

    @doc "删除帧（文章）"
    @handler DeleteFeed
    post /delete (DeleteFeedRequest) returns (StatusResponse)

    @doc "分享小红书帧（文章）"
    @handler ShareFeedXHS
    get /share/xhs returns (ShareFeedXHSResponse)

    @doc "点赞帧（文章）"
    @handler LikeFeed
    post /like (DeleteFeedRequest) returns (StatusResponse)

    @doc "收藏帧（文章）"
    @handler CollectFeed
    post /collect (DeleteFeedRequest) returns (StatusResponse)

    @doc "创作中心获取帧（文章）"
    @handler GetFeedListSelf
    get /feedlist/get (GetFeedListRequest) returns (GetFeedListResponse)
}