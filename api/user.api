syntax = "v1"

info(
    title: "General Chaozj API"
    desc: "the api for general chaozj service"
    author: "Trih"
    email: "hhh@chaozj.com"
    version: "v1"
)

type (
    RegisterRequest {
        Username string `json:"user_name"`
        Password string `json:"password"`
        Mobile string `json:"mobile"`
        VerifyCode string `json:"verifyCode"`
        CZJCode string `json:"czj_code,optional"` //邀请码用来绑定id
    }
    RegisterResponse {
        UserId uint64 `json:"user_id"`
        Token string `json:"token"`
        UserName string `json:"user_name"`
        Avatar string `json:"avatar"`
        Signature string `json:"signature"`
        UserType uint16 `json:"type"`
    }
    VerifyCodeRequest {
        Mobile string `json:"mobile"`
    }
    VerifyCodeResponse {
        Status string `json:"status"`
        TempCode string `json:"temp_code"`
    }
    LoginRequest {
        UserId uint64 `json:"user_id"`
        Password string `json:"password"`
    }
    LoginMobilePassRequest {
        Mobile string `json:"mobile"`
        Password string `json:"password"`
        KIP string `header:"kip,optional"`
    }
    LoginResponse {
        UserId uint64 `json:"user_id"`
        UserName string `json:"user_name"`
        Avatar string `json:"avatar"`
        Signature string `json:"signature"`
        UserType uint16 `json:"type"`
        Token string `json:"token"`
    }
    UserInfoRequest {
        UserId uint64 `path:"uid"`
    }
    UserInfoResponse {
        UserId uint64 `json:"user_id"`
        Username string `json:"user_name"`
        Avatar string `json:"avatar"`
        Type uint16 `json:"type"`
        Status uint8 `json:"status"`
        VNote string `json:"v_note"`
        Signature string `json:"signature"`
        FeedCount uint64 `json:"feed_count"`
        FansCount uint64 `json:"fans_count"`
        FollowCount uint64 `json:"follow_count"`
        IpLocation string `json:"ip_location"`
        ActiveTime uint64 `json:"active_time"`
        BanTime int8 `json:"ban_time"`
    }
)

type (
    Auth {
        Token string `json:"token"`
    }

    ChangePasswordRequest {
        NewPassword string `json:"new_password"`
    }

    ChangePasswordResponse {
        Status string `json:"status"`
    }

    ChangeUserInfoRequest {
        Nickname string `json:"nick_name"`   // 昵称
        Signature string `json:"signature"`  // 简介
        Avatar string `json:"avatar"`        // 头像
    }

    ChangeUserInfoResponse {
        Status string `json:"status"`
    }
    UserRelationResponse {
        LikeFeedList string `json:"like_feeds"`       // 点赞帖子
        CollectFeedList string `json:"collect_feeds"` // 收藏帖子
        LikeCommentList string `json:"like_comments"` // 点赞评论
        FollowList string `json:"follow_users"`       // 关注列表
    }

    ChangeMobileRequest {
        NewMobile string `json:"new_mobile"`
        VerifyCode string `json:"verifyCode"`
    }
    ChangeMobileResponse {
        Status string `json:"status"`
    }
)

@server(
    prefix: /v1/user
    group: user
)
service keyframeGo {
    @doc "用户注册"
    @handler RegisterHandler
    post /register (RegisterRequest) returns (RegisterResponse)

    @doc "获取用户信息"
    @handler UserInfoHandler
    get /:uid (UserInfoRequest) returns (UserInfoResponse)

    @doc "获取验证码"
    @handler VerifyCodeHandler
    post /verify-code (VerifyCodeRequest) returns (VerifyCodeResponse)

    @doc "uid账号登录"
    @handler LoginHandler
    post /login (LoginRequest) returns (LoginResponse)

    @doc "手机密码登录"
    @handler LoginByMobilePassHandler
    post /login-mobile-pass (LoginMobilePassRequest) returns (LoginResponse)
}

@server(
    prefix: /v1/user
    signature: true
    jwt: Auth
    //    middleware: TokenUpdateMiddleware
    group: user
)

service keyframeGo {
    @doc "获取用户关注、收藏、点赞列表"
    @handler UserRelationHandler
    get /relation returns (UserRelationResponse)

    @doc "更改密码(token)"
    @handler ChangePasswordHandler
    post /change-password (ChangePasswordRequest) returns (ChangePasswordResponse)

    @doc "更改用户信息(token)"
    @handler ChangeUserInfoHandler
    post /change-info (ChangeUserInfoRequest) returns (ChangeUserInfoResponse)

    @doc "更改手机号码(token)"
    @handler ChangeMobileHandler
    post /change-mobile (ChangeMobileRequest) returns (ChangeMobileResponse)
}