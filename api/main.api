syntax = "v1"

import "user.api"
import "home.api"
import "feed.api"
import "follow.api"
import "admin.api"
import "upload.api"

type (
	User {
		Nickname  string `db:"nick_name"` // 昵称
		Signature string `db:"signature"` // 简介
		Avatar    string `db:"avatar"` // 头像
		Type      uint8  `db:"type"` // 状态 0:默认用户 1:正式用户 2:V认证用户 3:管理员用户
	}
)

