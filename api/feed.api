syntax = "v1"
type (
    // 文章
    FeedDetail {
        Title string `json:"title"`                                                       // 标题
        Id uint64 `json:"id"`                                                             // ID
        MediaUrl string `json:"media_url"`                                                // 封面
        Content string `json:"content"`                                                   // 内容
        CommentNum uint64 `json:"comment_num"`                                            // 评论数
        LikeNum uint64 `json:"like_num"`                                                  // 点赞数
        CollectNum uint64 `json:"collect_num"`                                            // 收藏数
        MediaInfo MediaInfo `json:"media"`                                                // 多媒体信息
        MediaList []string `json:"media_list"`                                            // 多媒体列表
        Author FeedUser `json:"user"`                                                     // 作者
        PublishTime uint64 `json:"publish_time"`                                          // 发布时间
        IpLocation string `json:"ip_location"`                                            // ip归属地
    }
)
type (
    NewFeedRequest {
        Title string `json:"title"`                   // 标题
        Content string `json:"content"`               // 内容
        Media []string `json:"media"`                 // 封面
        Description string `json:"description"`       // 描述
    }

    StatusResponse {
        status string `json:"status"`
    }

    DeleteFeedRequest {
        Id uint64 `json:"id"`
    }

    GetFeedDetailRequest {
        Id uint64 `path:"id"`
    }

    GetFeedDetailResponse {
        Feed FeedDetail `json:"Feed"`
    }
)

@server(
    prefix: /v1/feed
    group: feed
    signature: true
)


service keyframeGo {
    @doc "帧（文章）详情"
    @handler GetFeedDetail
    get /:id (GetFeedDetailRequest) returns (GetFeedDetailResponse)
}


@server(
    prefix: /v1/feed
    group: feed
    signature: true
    jwt: Auth
)


service keyframeGo {
    @doc "创建帧（文章）"
    @handler NewFeed
    post /new (NewFeedRequest) returns (StatusResponse)

    @doc "删除帧（文章）"
    @handler DeleteFeed
    post /delete (DeleteFeedRequest) returns (StatusResponse)
}